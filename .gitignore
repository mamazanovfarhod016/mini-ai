# Mini AI — игнорируем служебные/личные файлы

# Python
__pycache__/
*.pyc
.venv/

# Сборка APK (регенерируется android/build.sh)
android/build/

# Личные данные владельца (НЕ для публичного репо) — см. docs/ASSISTANT_TEACH.md
data/personal/
model_personal/
android/build-personal/

# Экспорт пар пользователя для тестов teach.py — не секрет, но и не нужен в git постоянно
/tmp/

# Сервер самообучения: вопросы пользователей, очередь наставника, модели — личное, не в git
server_data/

# data/reasoning.json ~20 МБ — регенерируется детерминированно: .venv/bin/python tools/make_reasoning.py
data/reasoning.json

# сырые скачанные тексты для корпуса (пересобираются tools/make_corpus.py)
.cache_corpus/
.venv

# Задачи по Python — большой файл, пересобирается tools/make_python_tasks.py
data/python_tasks.json

# большие датасеты (локально, не в git)
data/ru/dataset.jsonl.gz
data/ru/ru_dialogues2.jsonl
